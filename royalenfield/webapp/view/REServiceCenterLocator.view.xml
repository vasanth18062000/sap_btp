<mvc:View controllerName="ns.royalenfield.controller.REServiceCenterLocator"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns="sap.m" xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml">
    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader>
                <Button press=".onbackToTile" text="Back" type="Emphasized" class="button1" icon="sap-icon://nav-back"/>
                <!-- <Title text="{i18n>RoyalEnfieldServiceCenter}" /> -->

                 <VBox>
                    <Image
                        id="_IGenmag1"
                        src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                        width="70%"
                        height="80%"
                    />
                </VBox>

                <!-- Spacer to push content to the right -->
                <ToolbarSpacer />

                <!-- Middle Text -->
                <Title id="serviceCenterLocatorTitle" text="{i18n>ServiceCentreLocator}" class="customHeaderStoreLocator" />

                <!-- Spacer to push the logo to the right -->
                <ToolbarSpacer />

                <!-- Ladera logo aligned to the right -->
                <VBox>
                    <Image
                        id="_IGenmag2"
                        src="{i18n>LaderaLogo}"
                        width="100px"
                        height="100px"
                    />
                </VBox>     
                
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation>
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="{i18n>india}" select="onSelectIndia" />
                </tnt:NavigationList>
                <tnt:fixedItem></tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <NavContainer id="pageContainer" initialPage="pageUSA">
                <pages>
                    <ScrollContainer id="pageIndia" horizontal="false" vertical="true" height="100%">
                        <html:iframe height="1000px" width="100%"
                            src='https://www.royalenfield.com/in/en/locate-us/service-centres/'></html:iframe>
                    </ScrollContainer>
                </pages>
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>