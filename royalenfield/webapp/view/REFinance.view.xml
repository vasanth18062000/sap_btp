                                    <core:Item id="_IDGenItem59" key="9" text="9.5%" />
                                    <core:Item id="_IDGenItem60" key="10" text="10.5%" />
                                    <core:Item id="_IDGenItem61" key="11" text="11.5%" />
                                    <core:Item id="_IDGenItem62" key="12" text="12.5%" />
                                </items>
                            </Select>
                            <Button id="_IDGenButton12" text="{i18n>CalculateEmi}" type="Emphasized"
                                press="onCalculateEMI_Scram" class="sendButton" />
                        </VBox>
                    </VBox>
                </Panel>
            </VBox>
        </content>
        <content>
            <Text id="_IDGenText62" text="{i18n>fydt}" class="headerText" />
                <VBox id="_IDGenVBox30" class="contactUsVBox">
                    <!-- Form Section -->
                    <VBox id="_IDGenVBox31" class="formSection">
                        <Label id="_IDGenLabel5" text="{i18n>fullName}" labelFor="nameInput" />
                        <Input id="nameInput" placeholder="{i18n>EnterYourName}" class="inputField" />
    
                        
    
                        <Label id="_IDGenLabel14" text="{i18n>emailad}" labelFor="emailInput" />
                        <Input id="emailidInput" placeholder="{i18n>EnterYourEmailAddress}" type="text"
                            class="inputField" />
    
                        <Label id="_IDGenLabel15" text="{i18n>PhoneNumber}" labelFor="emailInput" />
                        <Input id="mobileNumberInput" placeholder="{i18n>EnterYourPhoneNumber}"
                            type="Number"
                            class="inputField" />
                        
                            <Label id="_IDGenLabel16" text="{i18n>city}" labelFor="cityInput" />
                            <Input id="cityInput" placeholder="{i18n>enterYourCity}"
                                class="inputField" />
                        <Label id="_IDGenLabel17" text="{i18n>intrested}" labelFor="test" />
                        <RadioButtonGroup id="_IDGenRadioButtonGroup">
                            <RadioButton id="_IDGenRadioButton" text="{i18n>Yes}" />
                            <RadioButton id="_IDGenRadioButton1" text="{i18n>No}" />
                        </RadioButtonGroup>
                        <Text id="_IDGenText63" class="disclaimer" text="{i18n>disc}" />
                        <!-- Submit Button -->
                        <Button id="_IDGenButton16" text="{i18n>Submit}" type="Emphasized" press=".onSubmit" class="sendButton" />
                    </VBox>
                </VBox>
        </content>
        <content>
            <VBox id="_IDGenVBox32" class="sapUiSmallMargin">
                <Image id="_IDGenImage28"
                    src="{i18n>financepartner}"
                    alt="Royal Enfield Logo"
                    width="100%" height="100%" />
            </VBox>
        </content>
        
        <footer>
            <OverflowToolbar id="_IDGenOverflowToolbar2">
                <ToolbarSpacer id="_IDGenToolbarSpacer3" />
                <Button id="_IDGenButton13"
                    class="chatusicon"
                    icon="img/chatus.png" 
                press="handleMessagePopoverPress"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>