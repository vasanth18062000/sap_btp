                                    <core:Item id="_IDGenItem50" key="12" text="12.5%" />
                                </items>
                            </Select>
                            <Button id="_IDGenButton11" text="{i18n>CalculateEmi}" type="Emphasized"
                                press="onCalculateEMI_Himalayan" class="sendButton" />
                        </VBox>
                    </VBox>
                </Panel>
                <Panel id="_IDGenPanel6" headerText="{i18n>efs4}" expandable="true" expanded="false">
                    <VBox id="_IDGenVBox45" class="sapUiSmallMargin">
                        <Image id="_IDGenImage23" src="{i18n>him}" alt="Loan Details" width="20%" />
                        <Text id="_IDGenText34" text="{i18n>BikePrice} (₹) : 450000" />
                        <VBox id="_IDGenVBox46" class="formSection">
                            <Label id="_IDGenLabel47" text="{i18n>LoanAmount}" />
                            <Input id="loanamountInput_Scram"
