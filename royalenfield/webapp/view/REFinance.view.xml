                            <Label id="_IDGenLabel48" text="{i18n>Tenure} ({i18n>Month})" />
                            <Select id="loantenure_Scram" class="inputField">
                                <items>
                                    <core:Item id="_IDGenItem51" key="12" text="12 {i18n>Month}" />
                                    <core:Item id="_IDGenItem52" key="24" text="24 {i18n>Month}" />
                                    <core:Item id="_IDGenItem53" key="36" text="36 {i18n>Month}" />
                                    <core:Item id="_IDGenItem54" key="48" text="48 {i18n>Month}" />
