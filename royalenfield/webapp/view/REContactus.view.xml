<mvc:View
    controllerName="ns.royalenfield.controller.REContactus"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:html="http://www.w3.org/1999/xhtml">
    <Page title="Royal Enfield"  showHeader="true" >
        <customHeader>
        <OverflowToolbar id="_IDGenOverflowToolbar1">
            <Bar>
                <contentLeft>
                    <Button press=".onbackToTile" text="Back" type="Emphasized" class="button1" icon="sap-icon://nav-back"/>

                    <Image
                                id="_IDGenmage1"
                                src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                                width="70%"
                                height="90%"
                            />
                </contentLeft>
                <contentMiddle>
                <Title text="{i18n>CustomerQuery}" class="customHeaderTitle" />
                    <!-- Centered Logo -->
                    <!-- <Image 
                        src="{i18n>RELogo}"
                        alt="Royal Enfield Logo" 
                        width="100%" height="100%" /> -->
                        <!-- <Image src="img/re3.png" width="50px" class="movingBike" /> -->
                </contentMiddle>
                <contentRight>
                        <Image id="_IDGenImage2" src="{i18n>LaderaLogo}" width="100%" height="300%" />
                    </contentRight>
            </Bar>
            </OverflowToolbar>
        </customHeader>
        <content>
            <Text text="{i18n>contactUs}" class="headerText" />
            <VBox class="contactUsVBox">
                <Text class="introText"
                    text="{i18n>cuaar}" />

                <!-- Form Section -->
                <VBox class="formSection">
                    <Label text="{i18n>YourName}" labelFor="nameInput" />
                    <Input id="name" placeholder="{i18n>EnterYourName}" class="inputField" />

                    <!-- Email Input -->
                    <Label text="{i18n>EmailID}" labelFor="emailInput" />
                    <Input id="emailId" placeholder="{i18n>EnterYourMailId}" type="Email"
                        class="inputField" />

                    <!-- Phone Number Input -->
                    <Label text="{i18n>PhoneNumber}" labelFor="phoneInput" />
                    <Input id="mobileNumber" placeholder="{i18n>EnterYourPhoneNumber}" type="Number"
                        class="inputField" />

                    <!-- Question Text Area -->
                    <Label text="{i18n>yourQuestion}" labelFor="questionInput" />
                    <TextArea id="anyQueries" placeholder="{i18n>enterYourQuestion}" rows="4"
                        class="inputField" />

                    <!-- Submit Button -->
                    <Button text="{i18n>send}" type="Emphasized" press=".onSubmit" class="sendButton" />
                </VBox>
            </VBox>

            <!-- Static Contact Info -->
          
        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    class="chatusicon"
                    icon="img/chatus.png" 
                press="handleMessagePopoverPress"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>