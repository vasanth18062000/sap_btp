<mvc:View controllerName="ns.royalenfield.controller.REExternalChart"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns="sap.m" xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" >
        <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader>
                <Button press=".onbackToRoyal" text="Back" type="Emphasized" class="button1" icon="sap-icon://nav-back"/>
                <!-- <Title text="{i18n>RoyalEnfieldServiceCenter}" /> -->

                 <VBox>
                    <Image
                        id="_IGenmag1"
                        src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                        width="70%"
                        height="80%"
                    />
                </VBox>

                <!-- Spacer to push content to the right -->
                <ToolbarSpacer />

                <!-- Middle Text -->
                <Title id="serviceCenterLocatorTitle" text="{i18n>ExternalSalesChart}" class="customHeaderExternalChart" />

                <!-- Spacer to push the logo to the right -->
                <ToolbarSpacer />

                <!-- Ladera logo aligned to the right -->
                <VBox>
                    <Image
                        id="_IGenmag2"
                        src="{i18n>LaderaLogo}"
                        width="100px"
                        height="100px"
                    />
                </VBox>     
                
            </tnt:ToolHeader>
        </tnt:header>
    <tnt:mainContents>
            <NavContainer id="pageContainer" initialPage="pageUSA">
                <pages>
                    <ScrollContainer id="pageIndia" horizontal="false" vertical="true" height="90%">
<VBox >
<HBox id="tableauContainer"  width="100%" height="100%"></HBox>
</VBox>
</ScrollContainer>
</pages>
</NavContainer>
</tnt:mainContents>
</tnt:ToolPage>
</mvc:View>