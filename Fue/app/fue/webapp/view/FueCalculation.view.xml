<mvc:View
    controllerName="fue.fue.controller.FueCalculation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:form="sap.ui.layout.form"
    xmlns:smarttable="sap.ui.comp.smarttable"
    xmlns="sap.m"
    height="100%">
 
    <NavContainer id="wizardNavContainer">
        <pages>
            <Page id="wizardContentPage" showHeader="false">
                <content>
                    <Wizard id="UploadWizard" complete="onWizardComplete">
 
                        <!-- Step 1: Customer Details -->
                        <WizardStep id="StepCustomerDetails" title="Customer Details" validated="true">
                            <form:SimpleForm id="_IDGenSimpleForm" layout="ResponsiveGridLayout">
                                <Label id="_IDGenLabel" text="Customer Name" required="true"/>
                                <ComboBox
                                    width="10rem"
                                    id="YearCombobox"
                                    enabled="{StateModel>/yearComboBox}"
                                    selectionChange="onYearSelChange"
                                    items="{YearModel>/}">
                                    <core:Item id="_IDGenItem" key="{YearModel>key}" text="{YearModel>name}" />
                                </ComboBox>
                            </form:SimpleForm>
                        </WizardStep>
 
                        <!-- Step 2: Upload File 1 -->
                        <WizardStep id="StepUploadFile1" title="Upload File 1" validated="true">
                            <VBox id="_IDGenVBox">
                                <Label id="_IDGenLabel1" text="Upload File 1" design="Bold" required="true"/>
                                <u:FileUploader
                                    id="fileUploader1"
                                    name="myFileUpload"
                                    uploadUrl="upload/"
                                    uploadComplete="handleUploadComplete"/>
                                <Button id="_IDGenButton1"
                                    text="Upload File"
                                    press="handleUploadPress"
                                    class="sapUiTinyMarginTop"/>
                                <smarttable:SmartTable
                                    id="SmartTable1"
                                    smartFilterId="smartFilterBar"
                                    entitySet="TcodeMapping"
                                    enableAutoBinding="true"
                                    tableType="ResponsiveTable"
                                    initiallyVisibleFields="secruityRoleLevel,s4HanaForSelfServiceUse,tCode"
                                    header="Tcode Mapping Table">
                                    <Table id="_IDGenTable" growing="true" growingThreshold="10" mode="SingleSelectMaster"/>
                                </smarttable:SmartTable>
                            </VBox>
                        </WizardStep>
 
                        <!-- Step 3: Upload File 2 -->
                        <WizardStep id="StepUploadFile2" title="Upload File 2" validated="true">
                            <VBox id="_IDGenVBox1">
                                <Label id="_IDGenLabel2" text="Upload File 2" design="Bold" required="true"/>
                                <u:FileUploader
                                    id="fileUploader2"
                                    name="myFileUpload"
                                    uploadUrl="upload/"
                                    uploadComplete="handleUploadComplete"/>
                                <Button id="_IDGenButton2"
                                    text="Upload File"
                                    press="handleUploadPress1"
                                    class="sapUiTinyMarginTop"/>
                                <smarttable:SmartTable
                                    id="SmartTable2"
                                    smartFilterId="smartFilterBar"
                                    entitySet="TcodeMapping"
                                    enableAutoBinding="true"
                                    tableType="ResponsiveTable"
                                    initiallyVisibleFields="secruityRoleLevel,s4HanaForSelfServiceUse,tCode"
                                    header="Tcode Mapping Table">
                                    <Table id="_IDGenTable1" growing="true" growingThreshold="10" mode="SingleSelectMaster"/>
                                </smarttable:SmartTable>
                            </VBox>
                        </WizardStep>
 
                        <!-- Step 4: Role File Upload -->
                        <WizardStep id="StepRoleUpload" title="Upload Role File" validated="true">
                            <Text id="_IDGenText" text="Role file content goes here..." />
                        </WizardStep>
 
                        <!-- Step 5: Run Mapping -->
                        <WizardStep id="StepRunMapping" title="Run Mapping" validated="true">
                            <Text id="_IDGenText1" text="Run mapping content goes here..." />
                        </WizardStep>
 
                        <!-- Step 6: FUE Calculation -->
                        <WizardStep id="StepFUECalculation" title="FUE Calculation" validated="true">
                            <Text id="_IDGenText2" text="FUE calculation content goes here..." />
                        </WizardStep>
 
                    </Wizard>
                </content>
                <footer>
                    <OverflowToolbar id="_IDGenOverflowToolbar">
                        <ToolbarSpacer id="_IDGenToolbarSpacer" />
                        <Button id="_IDGenButton3" text="Cancel" press="onWizardCancel" />
                    </OverflowToolbar>
                </footer>
            </Page>
 
            <!-- Review Page (optional) -->
            <Page id="wizardReviewPage" showHeader="false">
                <content>
                    <Text id="_IDGenText3" text="Review your inputs here..." />
                </content>
                <footer>
                    <Bar id="_IDGenBar">
                        <contentRight>
                            <Button id="_IDGenButton4" text="Submit" press="onWizardSubmit"/>
                            <Button id="_IDGenButton5" text="Cancel" press="onWizardCancel"/>
                        </contentRight>
                    </Bar>
                </footer>
            </Page>
        </pages>
    </NavContainer>
</mvc:View>